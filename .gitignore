# 가상환경 (중요)
# ----------------------
venv/
env/
ENV/
.venv/

# ----------------------
# Django 설정 파일
# ----------------------
*.log
*.pot
*.pyc
db.sqlite3
db.sqlite3-journal

# ----------------------
# 미디어 / 업로드 파일
# ----------------------
media/

# ----------------------
# 정적 파일 (collectstatic 결과)
