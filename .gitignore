# ----------------------
# static/

# ----------------------
# 환경 변수 파일 (중요 - 보안)
# ----------------------
.env
.env.*

# ----------------------
# Django Secret Key 보호
# ----------------------
# settings_local.py 같은 파일 사용 시
settings_local.py

# ----------------------
# IDE / 에디터
# ----------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------
# OS 관련 파일
# ----------------------
.DS_Store
Thumbs.db

# ----------------------
